# ---- Database ----
DATABASE_URL=postgresql://ff:ff_password@localhost:5432/ff?schema=public

# ---- Cache (optional; app degrades gracefully if unset/unavailable) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# ---- Server ----
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ---- AI rule assistant (optional) ----
# Leave OPENAI_API_KEY unset to use the offline heuristic provider (no network).
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=8000
